# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=vscodeoffline

SYNCARGS=--sync
# SYNCARGS="--sync --skip-binaries --check-specified-extensions --total-recommended 0"
BIND=0.0.0.0:80

SSLARGS=
# === STEP CA CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=80
VIRTUAL_HOST=vscgallery.local

# Step CA SSL certificate domain
LETSENCRYPT_HOST=vscgallery.local

# Email for Step CA certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com