# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, letsencrypt/.env.example, ferron/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=vscodeoffline

COMPOSE_EXTENDS=:docker-compose.default.yml #:docker-compose.ferron.yml

COMPOSE_FILE=docker-compose.yml${COMPOSE_EXTENDS:-}

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

SYNCARGS=--sync
# SYNCARGS="--sync --skip-binaries --check-specified-extensions --total-recommended 0"
BIND=0.0.0.0:80

SSLARGS=
# === LETSENCRYPT CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=80
VIRTUAL_HOST=vscgallery.example.com

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=vscgallery.example.com

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com
# mTLS ferron
COMPOSE_EXTENDS=:docker-compose.ferron.yml
TLS_CLIENT_CERTIFICATE=/app/data/ca/ca-tls.cert