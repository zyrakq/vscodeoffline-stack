# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=vscodeoffline

COMPOSE_EXTENDS=:docker-compose.default.yml #:docker-compose.ferron.yml

COMPOSE_FILE=docker-compose.yml${COMPOSE_EXTENDS:-}

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

SYNCARGS=--sync
# SYNCARGS="--sync --skip-binaries --check-specified-extensions --total-recommended 0"
BIND=0.0.0.0:80

SSLARGS=